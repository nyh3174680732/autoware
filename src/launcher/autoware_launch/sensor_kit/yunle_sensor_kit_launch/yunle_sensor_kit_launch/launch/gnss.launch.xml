<launch>
  <arg name="launch_driver" default="false" description="launch GNSS driver"/>

  <group>
    <push-ros-namespace namespace="gnss"/>

    <!-- NavSatFix to Pose (using gnss_poser) -->
    <include file="$(find-pkg-share autoware_gnss_poser)/launch/gnss_poser.launch.xml">
      <!-- Input: your GNSS navsatfix topic -->
      <arg name="input_topic_fix" value="navsatfix"/>
      <arg name="input_topic_orientation" value="/autoware_orientation"/>

      <!-- Output topics -->
      <arg name="output_topic_gnss_pose" value="pose"/>
      <arg name="output_topic_gnss_pose_cov" value="pose_with_covariance"/>
      <arg name="output_topic_gnss_fixed" value="fixed"/>
    </include>
  </group>
</launch>
